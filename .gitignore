# Godot 4+ specific ignores
.godot/

# Source assets (not needed at runtime)
source/

# Android build
/android/

# Export/build output
build/

# Netlify CLI 本地站点关联信息
.netlify/

# Windows specific
Thumbs.db
desktop.ini

# macOS
.DS_Store

# 插件/编辑器写入失败残留的临时文件（如 ~xxx.dll~RF123456.TMP）
*~RF*.TMP
*.tmp

# 临时截图与日志
.tmp_shots/
*.log

# Claude Code 本地配置（技能与检查脚本仍纳入版本管理）
.claude/settings.local.json

# Windows 导出产物（export_presets.cfg 当前输出到项目根目录）
/FingerEmpire.exe
/FingerEmpire.console.exe
/FingerEmpire.pck
/libgodotsteam.*.dll
/steam-multiplayer-peer.*.dll
/steam_api64.dll

# 网页房公网隧道组件（由 tools/get_cloudflared.ps1 下载，随发布 zip 分发）
/cloudflared.exe

# 手机远程控制台运行时数据
tools/mobile_console/queue.json
tools/mobile_console/token.txt

# AI 决策链路追踪产物（本地调试用）
docs/ai-analysis/trace/*.jsonl
